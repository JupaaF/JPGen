+#pragma once
+
+#include <cstdlib>
+
+namespace Kratos {
+
+// Experimental switches, read once per search/strategy instance. Keeping both
+// disabled preserves the reference path in the same binary for paired timings.
+inline bool DEMSearchOptimizationEnabled(const char* pName)
+{
+    const char* p_value = std::getenv(pName);
+    return p_value != nullptr && p_value[0] == '1' && p_value[1] == '\0';
+}
