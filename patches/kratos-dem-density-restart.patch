--- a/applications/DEMApplication/custom_elements/spheric_particle.cpp
+++ b/applications/DEMApplication/custom_elements/spheric_particle.cpp
@@ -190,6 +190,20 @@ void SphericParticle::Initialize(const ProcessInfo& r_process_info)
 {
     KRATOS_TRY
 
+    // A DEM restart already contains nodal rotation, contact-force history and
+    // neighbour bookkeeping. Rebuild only the runtime integration objects;
+    // the ordinary initialization below would erase the restored state.
+    if (r_process_info[IS_RESTARTED]) {
+        DEMIntegrationScheme::Pointer& translational_scheme = GetProperties()[DEM_TRANSLATIONAL_INTEGRATION_SCHEME_POINTER];
+        DEMIntegrationScheme::Pointer& rotational_scheme = GetProperties()[DEM_ROTATIONAL_INTEGRATION_SCHEME_POINTER];
+        SetIntegrationScheme(translational_scheme, rotational_scheme);
+        if (this->Is(DEMFlags::HAS_GLOBAL_DAMPING)) {
+            mGlobalDampingModel = pCloneGlobalDampingModel(this);
+            mGlobalDampingModel->mGlobalDamping = r_process_info[GLOBAL_DAMPING];
+        }
+        return;
+    }
+
     this->mInitializationTime = r_process_info[TIME];
     this->mIndentationInitialOption = r_process_info[CLEAN_INDENT_V2_OPTION];
 
