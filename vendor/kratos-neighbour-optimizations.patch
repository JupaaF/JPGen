@@ -786,6 +805,211 @@ class OMP_DEMSearch : public DEMSearch<OMP_DEMSearch>
       ///@name Private Inquiry
       ///@{
       ///
+        // CSR grid: each structure particle occurs once. The original bins
+        // remain the fallback for non-periodic or unsupported geometry.
+        std::vector<std::size_t> mCenterOffsets;
+        std::vector<std::size_t> mCenterCursors;
+        std::vector<std::size_t> mCenterCells;
+        std::vector<std::size_t> mCenterOrder;
+        std::vector<array_1d<double, 3>> mCenterPositions;
+        std::vector<double> mCenterRadii;
+
+        bool SearchPeriodicCenters(const ElementsContainerType& rStructure,
+                                   const ElementsContainerType& rQueries,
+                                   VectorResultElementsContainerType& rResults,
+                                   VectorDistanceType* pDistances) {
+            if (!mDomainPeriodicity || rStructure.empty()) return false;
+            std::array<double, 3> lengths;
+            for (std::size_t axis = 0; axis < 3; ++axis) {
+                lengths[axis] = this->mDomainMax[axis] - this->mDomainMin[axis];
+                if (!std::isfinite(lengths[axis]) || lengths[axis] <= 0.) {
+                    return false;
+                }
+            }
+            const auto& structure = rStructure.GetContainer();
+            const auto& queries = rQueries.GetContainer();
+            mCenterPositions.resize(structure.size());
+            mCenterRadii.resize(structure.size());
+            double structure_radius = 0., query_radius = 0.;
+            auto inspect = [&](const auto& particles, double& maximum, bool store) {
+                std::size_t index = 0;
+                for (const auto& element : particles) {
+                    auto* particle = dynamic_cast<SphericParticle*>(element.get());
+                    if (!particle) return false;
+                    const double radius = particle->GetSearchRadius();
+                    if (!std::isfinite(radius) || radius < 0.) return false;
+                    maximum = std::max(maximum, radius);
+                    const auto& center = element->GetGeometry()[0];
+                    for (std::size_t axis = 0; axis < 3; ++axis) {
+                        if (!std::isfinite(center[axis]) || center[axis] < this->mDomainMin[axis] ||
+                            center[axis] > this->mDomainMax[axis]) return false;
+                    }
+                    if (store) {
+                        mCenterPositions[index] = center.Coordinates();
+                        mCenterRadii[index] = radius;
+                    }
+                    ++index;
+                }
+                return true;
+            };
+            if (!inspect(structure, structure_radius, true)) return false;
+            if (&structure == &queries) query_radius = structure_radius;
+            else if (!inspect(queries, query_radius, false)) return false;
+            const double radius_sum = structure_radius + query_radius;
+            // Match the squared-distance epsilon used by Intersection(),
+            // including contacts just outside the exact radius sum.
+            const double cutoff = std::nextafter(std::sqrt(radius_sum * radius_sum +
+                                    std::numeric_limits<double>::epsilon()),
+                                    std::numeric_limits<double>::infinity());
+            if (!std::isfinite(cutoff) || cutoff <= 0.) return false;
+
+            std::array<std::size_t, 3> counts;
+            std::array<double, 3> inverse_width;
+            const std::size_t cap = std::max<std::size_t>(1, std::ceil(std::cbrt(structure.size())));
+            for (std::size_t axis = 0; axis < 3; ++axis) {
+                counts[axis] = std::max<std::size_t>(1, static_cast<std::size_t>(
+                                 std::min<double>(cap, std::floor(lengths[axis] / cutoff))));
+                while (counts[axis] > 1 && lengths[axis] / counts[axis] < cutoff) --counts[axis];
+                inverse_width[axis] = counts[axis] / lengths[axis];
+            }
+            auto coordinates = [&](const auto& center) {
+                std::array<std::size_t, 3> cell;
+                for (std::size_t axis = 0; axis < 3; ++axis) {
+                    cell[axis] = std::min(counts[axis] - 1, static_cast<std::size_t>(
+                                        (center[axis] - this->mDomainMin[axis]) * inverse_width[axis]));
+                }
+                return cell;
+            };
+            auto flatten = [&](const std::array<std::size_t, 3>& cell) {
+                return cell[0] + counts[0] * (cell[1] + counts[1] * cell[2]);
+            };
+            const std::size_t total_cells = counts[0] * counts[1] * counts[2];
+            mCenterOffsets.assign(total_cells + 1, 0);
+            mCenterCells.resize(structure.size());
+            mCenterOrder.resize(structure.size());
+            for (std::size_t i = 0; i < structure.size(); ++i) {
+                const auto cell = flatten(coordinates(mCenterPositions[i]));
+                mCenterCells[i] = cell;
+                ++mCenterOffsets[cell + 1];
+            }
+            for (std::size_t cell = 0; cell < total_cells; ++cell) {
+                mCenterOffsets[cell + 1] += mCenterOffsets[cell];
+            }
+            mCenterCursors = mCenterOffsets;
+            for (std::size_t i = 0; i < structure.size(); ++i) {
+                mCenterOrder[mCenterCursors[mCenterCells[i]]++] = i;
+            }
+            mExclusiveScratch.resize(ParallelUtilities::GetNumThreads());
+            #pragma omp parallel
+            {
+                auto& workspace = mExclusiveScratch[OpenMPUtils::ThisThread()];
+                #pragma omp for schedule(dynamic, 100)
+                for (int i = 0; i < static_cast<int>(queries.size()); ++i) {
+                    workspace.results.clear();
+                    workspace.distances.clear();
+                    const auto& query = queries[i];
+                    const auto& query_center = query->GetGeometry()[0];
+                    const double query_search_radius = static_cast<SphericParticle*>(query.get())->GetSearchRadius();
+                    const auto origin = coordinates(query_center);
+                    std::array<std::array<std::size_t, 3>, 3> adjacent;
+                    std::array<std::size_t, 3> used = {0, 0, 0};
+                    for (std::size_t axis = 0; axis < 3; ++axis) {
+                        for (int offset = -1; offset <= 1; ++offset) {
+                            const auto cell = (origin[axis] + counts[axis] + offset) % counts[axis];
+                            if (std::find(adjacent[axis].begin(), adjacent[axis].begin() + used[axis], cell) ==
+                                adjacent[axis].begin() + used[axis]) adjacent[axis][used[axis]++] = cell;
+                        }
+                    }
+                    for (std::size_t z = 0; z < used[2]; ++z) {
+                        for (std::size_t y = 0; y < used[1]; ++y) {
+                            for (std::size_t x = 0; x < used[0]; ++x) {
+                                const auto cell = flatten({adjacent[0][x], adjacent[1][y], adjacent[2][z]});
+                                for (auto entry = mCenterOffsets[cell]; entry < mCenterOffsets[cell + 1]; ++entry) {
+                                    const auto candidate_index = mCenterOrder[entry];
+                                    const auto& candidate = structure[candidate_index];
+                                    if (query == candidate) continue;
+                                    double delta[3];
+                                    for (std::size_t axis = 0; axis < 3; ++axis) {
+                                        delta[axis] = query_center[axis] - mCenterPositions[candidate_index][axis];
+                                        if (std::fabs(delta[axis]) > .5 * lengths[axis]) {
+                                            delta[axis] -= ((0. < delta[axis]) - (delta[axis] < 0.)) * lengths[axis];
+                                        }
+                                    }
+                                    const double squared_distance = delta[0] * delta[0] + delta[1] * delta[1] + delta[2] * delta[2];
+                                    const double radius_sum = query_search_radius + mCenterRadii[candidate_index];
+                                    if (squared_distance > radius_sum * radius_sum + std::numeric_limits<double>::epsilon()) continue;
+                                    // Retain Kratos' exact acceptance predicate;
+                                    // the contiguous data only reject candidates.
+                                    if (!ElementConfigureType::Intersection(query, candidate)) continue;
+                                    workspace.results.push_back(candidate);
+                                    if (pDistances) {
+                                        double distance = 0.;
+                                        ElementConfigureType::Distance(query, candidate, distance);
+                                        workspace.distances.push_back(distance);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    rResults[i].insert(rResults[i].begin(), workspace.results.begin(), workspace.results.end());
+                    if (pDistances) (*pDistances)[i].insert((*pDistances)[i].begin(),
+                                                           workspace.distances.begin(), workspace.distances.end());
+                }
+                workspace.results.clear();
+            }
+            return true;
+        }
+
+        class ReusablePeriodicBins : public BinsTypePeriodic {
+        public:
+            using BinsTypePeriodic::BinsTypePeriodic;
+
+            void ClearObjects() {
+                for (auto& cell : this->mCells) cell.Clear();
+            }
+
+            void Refill(ElementsContainerType::ContainerType& rElements) {
+                ClearObjects();
+                this->mObjectsBegin = rElements.begin();
+                this->mObjectsEnd = rElements.end();
+                this->mObjectsSize = rElements.size();
+                this->GenerateBins();
+            }
+        };
+
+        struct ExclusiveScratch {
+            ResultElementsContainerType results;
+            DistanceType distances;
+        };
+        std::vector<ExclusiveScratch> mExclusiveScratch;
+        std::unique_ptr<ReusablePeriodicBins> mpExclusivePeriodicBins;
+        std::size_t mExclusivePopulationSize = 0;
+        array_1d<double, 3> mExclusiveDomainMin;
+        array_1d<double, 3> mExclusiveDomainMax;
+
+        BinsType* PrepareExclusiveBins(ElementsContainerType::ContainerType& rElements,
+                                      BinsUniquePointerType& rTemporary) {
+            if (!mDomainPeriodicity) {
+                // Non-periodic bins recalculate their bounding box each time.
+                rTemporary = GetBins(rElements);
+                return rTemporary.get();
+            }
+            if (!mpExclusivePeriodicBins || mExclusivePopulationSize != rElements.size() ||
+                !std::equal(mExclusiveDomainMin.begin(), mExclusiveDomainMin.end(), this->mDomainMin.begin()) ||
+                !std::equal(mExclusiveDomainMax.begin(), mExclusiveDomainMax.end(), this->mDomainMax.begin())) {
+                mpExclusivePeriodicBins.reset(new ReusablePeriodicBins(rElements.begin(), rElements.end(),
