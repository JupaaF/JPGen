+        if (r_model_part.GetCommunicator().TotalProcesses() == 1 && mListOfGhostSphericParticles.empty()) {
+            // Raw pointers identify the population; IDs need not be consecutive.
+            // The calling thread owns the cache, and the OpenMP workers share
+            // aliases to disjoint per-worker reverse-connectivity arrays.
+            struct ConnectivityScratch {
+                std::vector<SphericParticle*> population;
+                std::unordered_map<SphericParticle*, std::size_t> indices;
